# Copy to .env.local for local overrides (optional).
#
# In development, leave VITE_API_URL unset: Vite proxies /api to the backend
# on http://127.0.0.1:8010 (change with VITE_API_PROXY_TARGET).
#
# In production (Netlify), set it to your Render backend:
# VITE_API_URL=https://bukuma-api.onrender.com/api/v1
